{
  "manifest_version": 3,
  "name": "Reel Focus — Playback Controls",
  "version": "1.1.1",
  "description": "Quiet, local playback controls and distraction-free focus mode for Instagram Reels.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [{
    "matches": ["https://www.instagram.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
